{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [
        "wpt.fyi",
        "storage.googleapis.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "allowWrite": ["tmp", "release-notes"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/wpt-runs.js *)",
      "Bash(node scripts/wpt-collect.js *)",
      "Bash(node scripts/wpt-inventory.js *)",
      "Bash(node scripts/wpt-report.js *)",
      "Bash(node scripts/wpt-subtests.js *)",
      "Bash(node scripts/wpt-grep.js *)",
      "Bash(node scripts/wpt-fetch-tests.js *)",
      "Bash(node scripts/wpt-state.js *)",
      "Bash(node scripts/wpt-resolve.js *)",
      "Bash(node scripts/selftest.js *)",
      "Bash(mkdir -p tmp)",
      "Bash(mkdir -p release-notes)",
      "Edit(tmp/**)",
      "Write(tmp/**)",
      "Edit(release-notes/**)",
      "Write(release-notes/**)",
      "Edit(/.claude/skills/wpt-release-notes/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ]
  }
}
