# Intermediate artifacts live in tmp/ by default. A diff.json is ~600KB and its
# contents change daily as new runs land on wpt.fyi, so it's noise in a diff —
# regenerate with scripts/wpt-diff.js instead of committing one.
tmp/

# Finished release notes. Regenerable from a diff and stale as soon as new runs
# land, so publish by copying elsewhere rather than committing.
release-notes/

# Per-machine Claude Code settings (e.g. defaultMode). Kept out of the committed
# settings.json so a permission stance doesn't apply to everyone who clones.
.claude/settings.local.json

# Node
node_modules/
npm-debug.log*
package-lock.json
.pnpm-store

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
